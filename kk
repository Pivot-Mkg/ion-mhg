.solution-swiper {
  overflow: visible;
  padding-bottom: 3rem;
}

.solution-swiper .swiper-button-next,
.solution-swiper .swiper-button-prev {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 10px 20px rgba(9, 46, 96, 0.12);
  color: var(--primary);
}

.solution-swiper .swiper-button-next::after,
.solution-swiper .swiper-button-prev::after {
  font-size: 1rem;
  font-weight: 700;
}

.solution-swiper .swiper-pagination-bullet {
  width: 8px;
  height: 8px;
  background: rgba(0, 38, 114, 0.25);
  opacity: 1;
}

.solution-swiper .swiper-pagination-bullet-active {
  background: var(--primary);
}
